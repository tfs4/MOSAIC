# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
.env
.env.*
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data (never versioned — see data/README.md)
data/*
!data/README.md
*.zarr
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.h5ad

# Model checkpoints
*.pt
*.pth
*.onnx
*.ckpt

# Experiment outputs: keep tables and configs, drop checkpoints / arrays
results/**
!results/**/
!results/**/*.md
!results/**/*.csv
!results/**/*.json

# Logs and process leftovers
*.log
logs/
nohup.out
*.out
*.pid

# Images / slides (patches live under data/)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.tif
*.tiff
*.svs
*.ndpi
!results/**/*.png

# Editors / OS
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
